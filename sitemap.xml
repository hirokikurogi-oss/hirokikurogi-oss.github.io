---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
  {%- if p.layout and p.layout != 'null' and p.sitemap != false %}
  <url>
    <loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
